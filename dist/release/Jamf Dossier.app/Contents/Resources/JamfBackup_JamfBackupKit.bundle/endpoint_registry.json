    {
      "object_type": "sso_configuration",
      "reason": "No single stable public endpoint consistently exports complete SSO provider configuration across Jamf Pro versions.",
      "source": "https://developer.jamf.com/jamf-pro/docs/jamf-pro-api-developer-resources",
      "workaround": "Document from Jamf Pro UI: Settings > System > Single Sign-On. Capture provider type, mapped attributes, failover behavior, and enablement state."
    },
    {
      "object_type": "api_integrations_secrets",
      "reason": "Webhook/API integration shared secrets are not retrievable in clear form for security.",
      "source": "https://developer.jamf.com/jamf-pro/reference/get_v1-webhooks",
      "workaround": "Record auth method and endpoint metadata only. Rotate and re-enter secret during restore."
    }
